# Supabase project settings → API. Only the public (publishable/anon) key belongs here.
# Never put the service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Bank connections (Plaid) — server-side only, never NEXT_PUBLIC_ ---
# From https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (test banks) or production (real accounts)
PLAID_ENV=sandbox
# Encrypts Plaid access tokens at rest. Generate once: openssl rand -base64 32
# (Changing it later invalidates existing connections; they'd need reconnecting.)
PLAID_TOKEN_KEY=
# Optional — enables background sync via Plaid webhooks and the daily cron.
# Supabase → Project Settings → API keys → service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=
# Vercel Cron sends this as a bearer token. Generate: openssl rand -hex 32
CRON_SECRET=

# Optional — public URL of this app, used for Plaid webhooks when self-hosting
# (e.g. https://ledger.example.com). On Vercel the request URL is used instead.
APP_URL=
